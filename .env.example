# GEMINI_API_KEY: Required for Gemini AI API calls (signal discovery, research, drafting).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_PASSWORD: Required. Single-user password that gates the whole app (UI + API).
APP_PASSWORD="MY_APP_PASSWORD"

# APP_URL: The URL where this applet is hosted (used for self-referential links).
APP_URL="MY_APP_URL"
